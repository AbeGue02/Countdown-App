{
  "expo": {
    "name": "Countdown-App",
    "slug": "Countdown-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "countdownapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.countdownapp.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.countdownapp.app.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.countdownapp.app",
          "widgets": [
            {
              "name": "CountdownWidget",
              "displayName": "Countdown",
              "description": "Shows your upcoming countdown on the home screen",
              "supportedFamilies": [
                "systemSmall"
              ]
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sqlite",
      "expo-widgets",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
